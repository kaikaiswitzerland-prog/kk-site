# =============================================================
# KaïKaï — Variables d'environnement (template)
# =============================================================
# Copier ce fichier en .env.local pour le développement local.
# En production, ces variables sont définies dans Vercel
# (Settings → Environment Variables — Production + Preview).
# NE JAMAIS commiter .env.local ou .env (ignorés par git).
#
# Note de nommage : le projet utilise le préfixe NEXT_PUBLIC_* pour les
# variables exposées au client (configuré dans vite.config.js via
# envPrefix), pas VITE_*. Conserve ce préfixe pour les variables front.

# ─── Supabase (base de données + auth) ──────────────────────────
# Front (publique, exposée au client) :
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement (bypass RLS — ne JAMAIS exposer au client).
# Utilisé par api/_lib/supabaseServer.js pour les Vercel Functions.
SUPABASE_SERVICE_ROLE_KEY=

# ─── SumUp (paiement carte) ─────────────────────────────────────
# Clé API privée + merchant code. Utilisés par api/create-checkout.js,
# api/sumup-webhook.js et api/sumup-refund.js.
SUMUP_SECRET_KEY=
SUMUP_MERCHANT_CODE=

# ─── Resend (emails transactionnels) ────────────────────────────
# Utilisé par api/_lib/resend.js pour les emails de confirmation et
# de remboursement.
RESEND_API_KEY=

# ─── Imprimante thermique Epson TM-m30II (ePOS-Print) ───────────
# URL du serveur ePOS-Print embarqué dans la TM-m30II. HTTPS obligatoire
# (l'admin tourne sur Vercel en HTTPS ; un POST HTTP vers l'IP locale serait
# bloqué par le navigateur pour mixed-content). Voir PRINTER_SETUP.md pour
# l'activation HTTPS sur l'imprimante et l'install du certificat sur l'iPad.
VITE_PRINTER_URL=https://192.168.1.103/cgi-bin/epos/service.cgi?devid=local_printer&timeout=10000

# ─── Mode simulation du Checkout (DEV UNIQUEMENT) ───────────────
# Avec VITE_CHECKOUT_DRY_RUN=true ET le serveur Vite de dev, « Commander »
# n'insère rien dans orders, n'appelle aucune fonction /api et ne déclenche
# aucun paiement : bandeau « MODE TEST » et confirmation fictive. Sans effet
# en build de production (import.meta.env.DEV vaut false). Ne pas définir sur
# Vercel. Voir CHECKOUT_DRY_RUN dans src/App.jsx.
# VITE_CHECKOUT_DRY_RUN=true
